    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :my-bibliography a doco:Bibliography ; \n        dcterms:hasPart :my-bibliographic-reference-01 .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
