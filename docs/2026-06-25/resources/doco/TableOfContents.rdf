  <rdf:Description rdf:nodeID="n3b1bab1f2e67482f9ea2fcacd8712072b232">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n3b1bab1f2e67482f9ea2fcacd8712072b237"/>
